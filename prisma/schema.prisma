// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationType {
  SOLO
  SALON
  BRAND
}

enum BookingStatus {
  PENDING
  CONFIRMED
  DECLINED
  EXPIRED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ConfirmationMode {
  MANUAL
  AUTO_ALL
  AUTO_TRUSTED
}

enum PrepaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Organization {
  id        String           @id @default(cuid())
  type      OrganizationType
  name      String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  locations Location[]
}

model Location {
  id             String  @id @default(cuid())
  organizationId String
  address        String
  city           String
  district       String?
  lat            Float?
  lng            Float?
  // Working hours per weekday, e.g. { "mon": ["09:00","18:00"], ... }
  workingHours   Json

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff        Staff[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Staff {
  id          String    @id @default(cuid())
  userId      String    @unique
  locationId  String
  username    String    @unique
  displayName String
  bio         String?
  avatarUrl   String?
  onboardedAt DateTime?

  // Request-to-book settings.
  confirmationMode    ConfirmationMode @default(MANUAL)
  holdDurationMinutes Int              @default(180)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  services        StaffService[]
  bookings        Booking[]
  waitlistEntries WaitlistEntry[]
  scheduleBlocks  ScheduleBlock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Fixed taxonomy tree (e.g. nails -> nails.manicure -> nails.manicure.gel).
// Seeded via migration/seed script, not user-editable.
model ServiceCategory {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  parentId String?

  parent   ServiceCategory?  @relation("ServiceCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children ServiceCategory[] @relation("ServiceCategoryTree")

  staffServices StaffService[]
}

model StaffService {
  id              String  @id @default(cuid())
  staffId         String
  categoryId      String
  displayName     String
  // Money is always an integer, never a float.
  priceCents      Int
  durationMinutes Int
  isActive        Boolean @default(true)

  staff    Staff           @relation(fields: [staffId], references: [id], onDelete: Cascade)
  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  bookings        Booking[]
  bookingServices BookingService[]
  reminderRules   ReminderRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id             String  @id @default(cuid())
  // Normalized to +380XXXXXXXXX
  phone          String  @unique
  name           String?
  telegramChatId String?
  notes          String?

  // Computed from no-shows / late cancellations.
  reliabilityScore      Int @default(100)
  noShowCount           Int @default(0)
  lateCancellationCount Int @default(0)

  bookings        Booking[]
  waitlistEntries WaitlistEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Overlap prevention (a staff member cannot have two overlapping bookings,
// or one overlapping an active PENDING hold) must be enforced at the DB
// transaction level via a Postgres exclusion constraint added in a
// follow-up migration — Prisma's schema language can't express
// EXCLUDE USING gist directly. The constraint excludes CANCELLED, NO_SHOW,
// DECLINED, and EXPIRED — only PENDING and CONFIRMED block a slot.
model Booking {
  id        String        @id @default(cuid())
  clientId  String
  staffId   String
  // Primary service (the first one chosen). A booking can cover several
  // procedures back-to-back — the full set lives in `services`, and
  // slotStart/slotEnd span their combined duration. Kept for quick access
  // and back-compat with single-service reads.
  serviceId String
  status    BookingStatus @default(PENDING)

  // Always stored in UTC; convert with date-fns-tz at the edges.
  slotStart DateTime
  slotEnd   DateTime

  // Set while PENDING; a hold past this time is lazily flipped to EXPIRED.
  holdExpiresAt DateTime?
  // When the master confirmed/declined — used for the response-time estimate.
  respondedAt   DateTime?
  cancelledAt   DateTime?

  client  Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  staff   Staff        @relation(fields: [staffId], references: [id], onDelete: Restrict)
  service StaffService @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  services   BookingService[]
  prepayment Prepayment?
  review     Review?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId, slotStart])
}

// All procedures included in a single booking (one appointment, several
// services performed back-to-back). Duration/price are summed from these.
model BookingService {
  id        String @id @default(cuid())
  bookingId String
  serviceId String

  booking Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service StaffService @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([bookingId, serviceId])
  @@index([serviceId])
}

model Prepayment {
  id            String           @id @default(cuid())
  bookingId     String           @unique
  amountCents   Int
  liqpayOrderId String?
  status        PrepaymentStatus @default(PENDING)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Only allowed when booking.status = COMPLETED; enforced in app logic.
// @unique on bookingId enforces one review per booking.
model Review {
  id        String  @id @default(cuid())
  bookingId String  @unique
  rating    Int
  comment   String?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// Master-defined time-off (a whole day, or a partial break within a
// working day) during which no slot is ever offered. Distinct from
// Booking — nothing is booked, the time is simply excluded from
// availability. Checked both when generating slots and again right
// before a booking is inserted (no DB-level constraint across tables).
model ScheduleBlock {
  id       String   @id @default(cuid())
  staffId  String
  // Always stored in UTC, same convention as Booking.
  startsAt DateTime
  endsAt   DateTime
  reason   String?

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([staffId, startsAt])
}

model WaitlistEntry {
  id          String    @id @default(cuid())
  clientId    String
  staffId     String
  desiredFrom DateTime
  desiredTo   DateTime
  notifiedAt  DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// Auth.js (NextAuth v5) Prisma adapter models.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // Only set for credentials (email/password) sign-up.
  passwordHash  String?

  accounts Account[]
  sessions Session[]
  staff    Staff?

  createdAt DateTime @default(now())
}

model ReminderRule {
  id              String  @id @default(cuid())
  serviceId       String
  weeksAfterVisit Int
  messageTemplate String
  isActive        Boolean @default(true)

  service StaffService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
