// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationType {
  SOLO
  SALON
  BRAND
}

enum BookingStatus {
  PENDING
  CONFIRMED
  DECLINED
  EXPIRED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ConfirmationMode {
  MANUAL
  AUTO_ALL
  AUTO_TRUSTED
}

enum ImportJobStatus {
  PENDING
  RUNNING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

enum ImportTaskStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ImportedBusinessStatus {
  IMPORT_PENDING_REVIEW
  PUBLISHED
  REJECTED
}

enum EnrichmentStatus {
  NOT_STARTED
  QUEUED
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
  NO_WEBSITE
  NO_PRICES_FOUND
}

model Organization {
  id        String           @id @default(cuid())
  type      OrganizationType
  name      String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  locations Location[]
}

model Location {
  id             String  @id @default(cuid())
  organizationId String
  address        String
  city           String
  district       String?
  lat            Float?
  lng            Float?
  // Working hours per weekday, e.g. { "mon": ["09:00","18:00"], ... }
  workingHours   Json

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff        Staff[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Staff {
  id          String    @id @default(cuid())
  userId      String    @unique
  locationId  String
  username    String    @unique
  displayName String
  bio         String?
  avatarUrl   String?
  onboardedAt DateTime?

  // Request-to-book settings.
  confirmationMode    ConfirmationMode @default(MANUAL)
  holdDurationMinutes Int              @default(180)

  // Telegram: chat id where the bot notifies this master; link token is the
  // one-time secret embedded in the t.me/<bot>?start=<token> deep link.
  telegramChatId    String?
  telegramLinkToken String? @unique

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  services        StaffService[]
  bookings        Booking[]
  waitlistEntries WaitlistEntry[]
  scheduleBlocks  ScheduleBlock[]
  clientNotes     ClientNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Fixed taxonomy tree (e.g. nails -> nails.manicure -> nails.manicure.gel).
// Seeded via migration/seed script, not user-editable.
model ServiceCategory {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  parentId String?

  parent   ServiceCategory?  @relation("ServiceCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children ServiceCategory[] @relation("ServiceCategoryTree")

  staffServices StaffService[]
}

model StaffService {
  id                  String  @id @default(cuid())
  staffId             String
  categoryId          String
  displayName         String
  // Money is always an integer, never a float.
  priceCents          Int
  durationMinutes     Int
  isActive            Boolean @default(true)
  // Weeks after a completed visit to nudge the client to rebook (Камбекер).
  // Null = don't remind for this service.
  rebookReminderWeeks Int?

  staff    Staff           @relation(fields: [staffId], references: [id], onDelete: Cascade)
  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  bookings        Booking[]
  bookingServices BookingService[]
  reminderRules   ReminderRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id                String  @id @default(cuid())
  // Normalized to +380XXXXXXXXX
  phone             String  @unique
  name              String?
  telegramChatId    String?
  // One-time secret in the t.me/<bot>?start=c_<token> deep link the client taps.
  telegramLinkToken String? @unique
  notes             String?

  // Computed from no-shows / late cancellations.
  reliabilityScore      Int @default(100)
  noShowCount           Int @default(0)
  lateCancellationCount Int @default(0)

  bookings        Booking[]
  waitlistEntries WaitlistEntry[]
  clientNotes     ClientNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A master's private note about a client — per (staff, client), so notes never
// leak across masters who happen to share a client (by phone).
model ClientNote {
  id       String @id @default(cuid())
  staffId  String
  clientId String
  body     String

  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, clientId])
}

// Overlap prevention (a staff member cannot have two overlapping bookings,
// or one overlapping an active PENDING hold) must be enforced at the DB
// transaction level via a Postgres exclusion constraint added in a
// follow-up migration — Prisma's schema language can't express
// EXCLUDE USING gist directly. The constraint excludes CANCELLED, NO_SHOW,
// DECLINED, and EXPIRED — only PENDING and CONFIRMED block a slot.
model Booking {
  id        String        @id @default(cuid())
  clientId  String
  staffId   String
  // Primary service (the first one chosen). A booking can cover several
  // procedures back-to-back — the full set lives in `services`, and
  // slotStart/slotEnd span their combined duration. Kept for quick access
  // and back-compat with single-service reads.
  serviceId String
  status    BookingStatus @default(PENDING)

  // Always stored in UTC; convert with date-fns-tz at the edges.
  slotStart DateTime
  slotEnd   DateTime

  // Set while PENDING; a hold past this time is lazily flipped to EXPIRED.
  holdExpiresAt          DateTime?
  // When the master confirmed/declined — used for the response-time estimate.
  respondedAt            DateTime?
  cancelledAt            DateTime?
  // Timestamps marking that each Telegram nudge has gone out (prevents repeats).
  masterReminderSentAt   DateTime?
  clientReminder24SentAt DateTime?
  clientReminder1SentAt  DateTime?
  rebookReminderSentAt   DateTime?

  client  Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  staff   Staff        @relation(fields: [staffId], references: [id], onDelete: Restrict)
  service StaffService @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  services BookingService[]
  review   Review?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId, slotStart])
}

// All procedures included in a single booking (one appointment, several
// services performed back-to-back). Duration/price are summed from these.
model BookingService {
  id        String @id @default(cuid())
  bookingId String
  serviceId String

  booking Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service StaffService @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([bookingId, serviceId])
  @@index([serviceId])
}

// Only allowed when booking.status = COMPLETED; enforced in app logic.
// @unique on bookingId enforces one review per booking.
model Review {
  id        String  @id @default(cuid())
  bookingId String  @unique
  rating    Int
  comment   String?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// Master-defined time-off (a whole day, or a partial break within a
// working day) during which no slot is ever offered. Distinct from
// Booking — nothing is booked, the time is simply excluded from
// availability. Checked both when generating slots and again right
// before a booking is inserted (no DB-level constraint across tables).
model ScheduleBlock {
  id       String   @id @default(cuid())
  staffId  String
  // Always stored in UTC, same convention as Booking.
  startsAt DateTime
  endsAt   DateTime
  reason   String?

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([staffId, startsAt])
}

model WaitlistEntry {
  id          String    @id @default(cuid())
  clientId    String
  staffId     String
  desiredFrom DateTime
  desiredTo   DateTime
  notifiedAt  DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// Auth.js (NextAuth v5) Prisma adapter models.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // Only set for credentials (email/password) sign-up.
  passwordHash  String?

  accounts           Account[]
  sessions           Session[]
  staff              Staff?
  businessImportJobs BusinessImportJob[]

  createdAt DateTime @default(now())
}

model BusinessImportCity {
  id            String @id @default(cuid())
  provider      String
  externalId    String
  name          String
  formattedName String
  countryCode   String
  centerLat     Float
  centerLng     Float
  south         Float
  west          Float
  north         Float
  east          Float

  jobs BusinessImportJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, externalId])
}

model BusinessImportJob {
  id             String          @id @default(cuid())
  cityId         String
  provider       String
  status         ImportJobStatus @default(PENDING)
  categories     Json
  includeDetails Boolean         @default(true)

  totalTasks     Int @default(0)
  completedTasks Int @default(0)
  foundCount     Int @default(0)
  createdCount   Int @default(0)
  updatedCount   Int @default(0)
  duplicateCount Int @default(0)
  failedCount    Int @default(0)

  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  createdById  String?

  city      BusinessImportCity     @relation(fields: [cityId], references: [id], onDelete: Restrict)
  createdBy User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  tasks     BusinessImportTask[]
  results   BusinessImportResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([cityId, createdAt])
}

model BusinessImportTask {
  id           String           @id @default(cuid())
  jobId        String
  category     String
  searchQuery  String
  status       ImportTaskStatus @default(PENDING)
  south        Float
  west         Float
  north        Float
  east         Float
  depth        Int              @default(0)
  attempts     Int              @default(0)
  foundCount   Int              @default(0)
  errorMessage String?
  lockedAt     DateTime?
  startedAt    DateTime?
  completedAt  DateTime?

  job BusinessImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId, status])
  @@index([status, lockedAt])
}

model ImportedBusiness {
  id                   String                 @id @default(cuid())
  provider             String
  externalId           String
  name                 String
  slug                 String
  publicationStatus    ImportedBusinessStatus @default(IMPORT_PENDING_REVIEW)
  enrichmentStatus     EnrichmentStatus       @default(NOT_STARTED)
  manualReviewRequired Boolean                @default(false)
  countryCode          String
  city                 String
  district             String?
  formattedAddress     String
  lat                  Float
  lng                  Float
  nationalPhone        String?
  internationalPhone   String?
  normalizedPhone      String?
  websiteUri           String?
  normalizedDomain     String?
  googleMapsUri        String?
  rating               Float?
  userRatingCount      Int?
  primaryType          String?
  types                Json
  categories           Json
  regularOpeningHours  Json?
  businessStatus       String?
  normalizedName       String
  normalizedAddress    String
  sourceFetchedAt      DateTime
  lastSyncedAt         DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  importResults BusinessImportResult[]

  @@unique([provider, externalId])
  @@unique([slug])
  @@index([publicationStatus, city])
  @@index([normalizedPhone])
  @@index([normalizedDomain])
  @@index([normalizedName, normalizedAddress])
}

model BusinessImportResult {
  id         String @id @default(cuid())
  jobId      String
  businessId String
  category   String
  outcome    String

  job      BusinessImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  business ImportedBusiness  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, businessId])
  @@index([businessId])
}

model ReminderRule {
  id              String  @id @default(cuid())
  serviceId       String
  weeksAfterVisit Int
  messageTemplate String
  isActive        Boolean @default(true)

  service StaffService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
