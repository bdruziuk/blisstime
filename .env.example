DATABASE_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=
# Comma-separated emails allowed to access /admin (for example, two owner accounts)
SUPER_ADMIN_EMAILS=owner@example.com,admin@example.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=EasyServiceBookingBot
# Optional: secret echoed by Telegram on webhook calls (setWebhook secret_token)
TELEGRAM_WEBHOOK_SECRET=
# Shared secret guarding the reminders cron endpoint
CRON_SECRET=
OPENAI_API_KEY=
NEXT_PUBLIC_APP_URL=
# Search engines are blocked (noindex + robots.txt disallow) unless this is
# exactly "true". Set it only on the production domain at launch.
ALLOW_INDEXING=
